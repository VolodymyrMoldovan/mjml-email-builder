{
  "name": "mjml-email-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "A Vue 3 drag-and-drop email builder component powered by MJML",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/mjml-email-builder.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "mjml",
    "email",
    "email-builder",
    "email-template",
    "drag-and-drop",
    "wysiwyg",
    "typescript",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yourusername/mjml-email-builder/issues"
  },
  "homepage": "https://github.com/yourusername/mjml-email-builder#readme",
  "peerDependencies": {
    "mjml-browser": "^4.15.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.0.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^12.10.0",
    "mjml-browser": "^4.18.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0",
    "vue": "^3.3.0",
    "vue-tsc": "^1.8.0"
  }
}
